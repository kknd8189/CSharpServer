{
  "uid": "mmo-server",
  "title": "MMO Server",
  "tags": ["mmo", "gameserver"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "틱 처리 시간 — 30Hz 예산 33.3ms",
      "description": "히스토그램에서 계산한 분위수. 최댓값 하나에 좌우되지 않아 실제 수용 한계 판단에 쓸 수 있다.",
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 5 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.0333 }
            ]
          }
        }
      },
      "options": { "legend": { "displayMode": "table", "calcs": ["mean", "max"], "placement": "right" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(game_tick_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p50", "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(game_tick_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95", "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(game_tick_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99", "refId": "C"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "동시 접속자",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 400 },
          { "color": "red", "value": 700 } ] } } },
      "options": { "graphMode": "area", "colorMode": "value" },
      "targets": [ { "expr": "sum(game_players_connected)", "legendFormat": "CCU", "refId": "A" } ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "예산 초과 틱 비율 — 33ms를 넘긴 틱의 %",
      "description": "이 값이 0보다 유의미하게 커지는 CCU가 실질적인 수용 한계다. 최댓값 기준보다 훨씬 안정적인 지표.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "lineWidth": 2, "fillOpacity": 10 },
        "min": 0 } },
      "targets": [
        {
          "expr": "1 - (sum(rate(game_tick_duration_seconds_bucket{le=\"0.0333\"}[1m])) / sum(rate(game_tick_duration_seconds_count[1m])))",
          "legendFormat": "예산 초과 비율", "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "실측 틱 주파수 (Hz)",
      "description": "목표 30Hz. 여기가 떨어지면 게임이 실제로 느려진 것.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "hertz", "custom": { "lineWidth": 2, "fillOpacity": 5 },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null },
          { "color": "green", "value": 29 } ] } } },
      "targets": [
        { "expr": "sum(rate(game_ticks_total[1m]))", "legendFormat": "전체", "refId": "A" },
        { "expr": "sum(rate(game_ticks_total{kind=\"work\"}[1m]))", "legendFormat": "work", "refId": "B" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "패킷 처리량 (/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "fieldConfig": { "defaults": { "unit": "pps", "custom": { "lineWidth": 2, "fillOpacity": 5 } } },
      "targets": [
        { "expr": "sum(rate(game_packets_total{direction=\"recv\"}[1m]))", "legendFormat": "수신", "refId": "A" },
        { "expr": "sum(rate(game_packets_total{direction=\"send\"}[1m]))", "legendFormat": "송신", "refId": "B" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "검증 거부 (/s) — 급증 시 핵 유행 또는 오탐",
      "description": "거부율이 갑자기 튀면 임계값이 잘못돼 정상 유저를 끊고 있을 가능성부터 의심한다.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 20,
        "stacking": { "mode": "normal" } } } },
      "targets": [
        { "expr": "sum(rate(game_validation_rejected_total[1m])) by (kind)", "legendFormat": "{{kind}}", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "세션 종료 사유 (/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 20,
        "stacking": { "mode": "normal" } } } },
      "targets": [
        { "expr": "sum(rate(game_sessions_closed_total[1m])) by (reason)", "legendFormat": "{{reason}}", "refId": "A" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "세션 유지 시간 분위수",
      "description": "진입 직후 이탈이 많으면 p50이 바닥에 붙는다.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 5 } } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(game_session_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(game_session_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95", "refId": "B" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "브로드캐스트 팬아웃 — 1회당 수신자 수",
      "description": "브로드캐스트 비용은 '호출 수 x 팬아웃'이다. 소요 시간만 보면 둘 중 어느 쪽이 늘었는지 구분되지 않아 팬아웃을 따로 센다. 서버는 접속 시 맵 전역(111x111)에 균등 랜덤 스폰하므로 기본 분포에서는 시야(11x11=121칸) 안에 평균 7명뿐이다. 실제 유저는 마을/보스에 뭉치므로 이 값이 실측보다 훨씬 커진다. DummyClient 의 'cluster on' 으로 그 상황을 재현한다.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 33 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 5 } } },
      "options": { "legend": { "displayMode": "table", "calcs": ["mean", "max"], "placement": "bottom" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(game_broadcast_recipients_bucket[1m])) by (le))",
          "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(game_broadcast_recipients_bucket[1m])) by (le))",
          "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(game_broadcast_recipients_bucket[1m])) by (le))",
          "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "브로드캐스트 총량 (/s) — 진짜 부하 지표",
      "description": "'수신자 합계'가 초당 실제 유니캐스트 송신 건수다. 호출 수와 나눠 보면 부하가 늘어난 이유를 가를 수 있다. 호출 수가 늘었으면 유저가 더 많이 움직인 것이고, 호출 수는 그대로인데 합계만 늘었으면 밀집도가 오른 것이다. 밀도가 1/칸에 가까워지면 이동이 거부되기 시작해 호출 수가 오히려 줄어드는데, 그때는 옆 패널의 occupied 를 같이 봐야 한다.",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 33 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 5 } } },
      "options": { "legend": { "displayMode": "table", "calcs": ["mean", "max"], "placement": "bottom" } },
      "targets": [
        { "expr": "sum(rate(game_broadcast_recipients_sum[1m]))",
          "legendFormat": "수신자 합계 (송신 건수)", "refId": "A" },
        { "expr": "sum(rate(game_broadcast_recipients_count[1m]))",
          "legendFormat": "브로드캐스트 호출 수", "refId": "B" }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "이동 거부 (/s) — terrain vs occupied",
      "description": "맵은 한 칸에 한 오브젝트만 허용한다(Map.CanGo). 밀집도가 오르면 occupied 가 급증하고, 거부된 이동은 브로드캐스트를 만들지 않는다. 즉 팬아웃 부하는 밀도에 대해 단조 증가가 아니라 정점을 찍고 꺾인다. 이 패널이 없으면 '브로드캐스트가 줄었다'를 보고도 밀집이 안 된 건지 밀집돼서 못 움직이는 건지 구분할 수 없다. terrain 은 벽, occupied 는 다른 오브젝트가 그 칸을 차지한 경우다.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 33 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "options": { "legend": { "displayMode": "table", "calcs": ["mean", "max"], "placement": "bottom" } },
      "targets": [
        { "expr": "sum(rate(game_move_blocked_total[1m])) by (reason)",
          "legendFormat": "{{reason}}", "refId": "A" }
      ]
    }
  ]
}
